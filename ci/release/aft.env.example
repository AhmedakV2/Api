AFT_DB_URL=jdbc:postgresql://localhost:5432/aft
AFT_DB_USER=aft
AFT_DB_PASSWORD=

AFT_STATE_PROVIDER=coherence
AFT_COHERENCE_CLIENT=remote
AFT_COHERENCE_PROXY_HOST=
AFT_COHERENCE_PROXY_PORT=
AFT_COHERENCE_CLUSTER=
AFT_COHERENCE_CACHE_PREFIX=aft-
AFT_COHERENCE_TOPIC=aft-tool-result
AFT_COHERENCE_CACHE_CONFIG=

AFT_JWT_SECRET=
AFT_JWT_ACCESS_TTL=PT15M
AFT_JWT_REFRESH_TTL=P30D

AFT_CORS_ORIGINS=http://localhost:5173

AFT_LOGIN_MAX_ATTEMPTS=5
AFT_LOGIN_LOCK_DURATION=PT15M
AFT_RATE_ANON=20
AFT_RATE_AUTH=300
AFT_RATE_AGENT=30

AFT_AI_PROVIDER=ollama
AFT_AI_MODEL_PLANNER=llama3.1:8b
AFT_AI_MODEL_FAST=llama3.1:8b
AFT_AI_EMBEDDING_MODEL=nomic-embed-text
AFT_AI_REQUEST_TIMEOUT=PT120S

AFT_LOG_LEVEL=INFO
AFT_PROFILE=prod
AFT_MAX_RAM_PERCENT=75
AFT_JAVA_OPTS=
